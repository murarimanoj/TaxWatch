MONGODB_DATABASE=taxwatch
HTTP_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=TaxWatch-Regulatory-Ingestion/0.1 (contact: replace@example.com)
MAX_ITEMS_PER_RUN=25
SOURCE_CONFIG_PATH=config/sources.toml
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_CHANNEL=chrome
